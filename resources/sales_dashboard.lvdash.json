{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  SUM(sales_amount)               AS revenue,\n",
        "  COUNT(DISTINCT order_number)    AS orders,\n",
        "  COUNT(DISTINCT customer_key)    AS customers,\n",
        "  SUM(quantity)                   AS units\n",
        "FROM workspace.gold.fact_sales\n"
      ]
    },
    {
      "name": "monthly",
      "displayName": "Monthly revenue",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('month', order_date) AS month,\n",
        "  SUM(sales_amount)               AS revenue,\n",
        "  COUNT(DISTINCT order_number)    AS orders\n",
        "FROM workspace.gold.fact_sales\n",
        "WHERE order_date IS NOT NULL\n",
        "GROUP BY 1\n",
        "ORDER BY 1\n"
      ]
    },
    {
      "name": "by_country",
      "displayName": "Revenue by country",
      "queryLines": [
        "SELECT\n",
        "  c.country,\n",
        "  SUM(f.sales_amount) AS revenue\n",
        "FROM workspace.gold.fact_sales f\n",
        "JOIN workspace.gold.dim_customers c ON f.customer_key = c.customer_key\n",
        "GROUP BY 1\n",
        "ORDER BY 2 DESC\n"
      ]
    },
    {
      "name": "by_category",
      "displayName": "Revenue by category",
      "queryLines": [
        "SELECT\n",
        "  p.category,\n",
        "  p.subcategory,\n",
        "  SUM(f.sales_amount) AS revenue,\n",
        "  SUM(f.quantity)     AS units\n",
        "FROM workspace.gold.fact_sales f\n",
        "JOIN workspace.gold.dim_products p ON f.product_key = p.product_key\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 3 DESC\n"
      ]
    },
    {
      "name": "top_products",
      "displayName": "Top products",
      "queryLines": [
        "SELECT\n",
        "  p.product_name,\n",
        "  p.category,\n",
        "  SUM(f.sales_amount) AS revenue,\n",
        "  SUM(f.quantity)     AS units\n",
        "FROM workspace.gold.fact_sales f\n",
        "JOIN workspace.gold.dim_products p ON f.product_key = p.product_key\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 3 DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "gender_mix",
      "displayName": "Customers by gender",
      "queryLines": [
        "SELECT gender, COUNT(*) AS customers\n",
        "FROM workspace.gold.dim_customers\n",
        "GROUP BY 1\n"
      ]
    }
  ],
